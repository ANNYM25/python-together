# Normalize line endings so Windows/Mac/Linux collaborators don't fight over them.
* text=auto eol=lf

# Treat notebooks as text (so diffs/merges work) but don't let them skew the
# repo's language stats away from the Python being taught.
*.ipynb text linguist-documentation

# Common binary types — never try to line-ending-normalize these.
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
